# ── Carpe Diem POS — .env for the restaurant machine ─────────────────────────
#
# Copy this file to the POS, into the folder that holds docker-compose.yml, and
# rename it to exactly:  .env
# Fill in every <...>. Never commit the filled-in file, email it or paste it in a
# chat. These are the ONLY variables docker-compose.yml reads.
#
# Make each secret ON THE POS:
#   Windows PowerShell:
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
#   Linux:
#     openssl rand -hex 32
# Each run prints a new 64-character secret. Use a different one per line.
# Save them in your password manager.

# ── Database ─────────────────────────────────────────────────────────────────
# Letters and digits only (the generator above gives exactly that): it goes into
# a connection URL, where symbols break it. Set it BEFORE the first start and
# never change it afterwards — the database keeps the first one.
POSTGRES_PASSWORD=<generate: 64 hex characters>

# ── Sign-in ──────────────────────────────────────────────────────────────────
# Signs staff sessions. 32+ characters or the app refuses to start. Changing it
# signs everyone out, nothing else.
SESSION_SECRET=<generate: 64 hex characters>

# ── Printer (Xprinter XP-Q80B on its Ethernet port) ──────────────────────────
PRINTER_IP=192.168.8.250
PRINTER_PORT=9100
# Leave empty: USB would win over the network printer.
PRINTER_USB_NAME=

# ── Vendor access (/vendor: database export for backups) ─────────────────────
# A NEW secret for this machine (not the one used on the development PC).
VENDOR_SECRET=<generate: 64 hex characters>

# ── Restaurant ───────────────────────────────────────────────────────────────
RESTAURANT_NAME=Carpe Diem
TIMEZONE=Asia/Colombo

# ── Which image to run ───────────────────────────────────────────────────────
GHCR_IMAGE=ghcr.io/ktneranga/carpediem-impl
# The tag built for this restaurant (the `carpe-diem` branch). Never `latest`.
APP_TAG=stable-carpe-diem
# Keeps this POS's Watchtower to its own containers.
RESTAURANT_SCOPE=carpe-diem

# ── Pulling the private image (Watchtower updates) ───────────────────────────
# A GitHub token (classic) with read:packages ONLY — not the write token used to
# push images. Also used once by hand:  docker login ghcr.io -u <REPO_USER>
REPO_USER=ktneranga
REPO_PASS=<GitHub token with read:packages only>

# ── Watchtower HTTP API (optional) ───────────────────────────────────────────
# Lets an update be triggered remotely. Leave empty if unused.
WATCHTOWER_HTTP_API_TOKEN=

# ── NOT on the POS ───────────────────────────────────────────────────────────
# DATABASE_URL            — docker-compose.yml builds it (host `db`, not localhost).
# PG_DUMP_DOCKER_CONTAINER — development PC only.
# NODE_ENV, PORT          — set by docker-compose.yml.
