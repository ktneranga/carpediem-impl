# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/cdrms
DATABASE_POOL_MAX=20          # recommended for single-restaurant deployment (default: 10)
POSTGRES_PASSWORD=            # Docker db service password — must match the password in DATABASE_URL; read by docker-compose.yml

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED. Signs staff session cookies (HMAC-SHA256). The server refuses to
# start if this is missing or shorter than 32 characters — see server.ts.
SESSION_SECRET=               # 32+ character random string — generate with: openssl rand -hex 32

# Controls the `Secure` flag on the session cookie. Leave unset/false for the
# restaurant LAN, which serves plain HTTP on :3000 — a Secure cookie is never
# sent over HTTP, so enabling this without TLS silently breaks login entirely.
# Set to true only once the app is genuinely served over HTTPS.
HTTPS_ENABLED=false

# ── ESC/POS Printer ───────────────────────────────────────────────────────────
PRINTER_IP=                   # IP address of ESC/POS thermal printer on LAN (e.g. 192.168.1.200)
PRINTER_PORT=9100             # standard ESC/POS TCP port
PRINTER_USB_NAME=             # USB printer instead; wins over PRINTER_IP. Running natively on Windows: the printer NAME (e.g. XP-80C).
                              # In Docker: only a Linux device path (/dev/usb/lp0) with `devices:` in docker-compose.yml.

# ── Vendor Operations ─────────────────────────────────────────────────────────
VENDOR_SECRET=                # 16+ characters; enables /vendor (developer sign-in, database export). Unset = off. openssl rand -hex 24
WATCHTOWER_HTTP_API_TOKEN=    # Watchtower HTTP API token for on-demand update triggers
PORTAINER_URL=                # Portainer API base URL (e.g. http://localhost:9000)

# ── Remote Access ─────────────────────────────────────────────────────────────
TAILSCALE_AUTH_KEY=           # Tailscale auth key for this deployment

# ── Restaurant Identity ───────────────────────────────────────────────────────
RESTAURANT_NAME=              # Display name (e.g. "Carpe Diem")
TIMEZONE=Asia/Colombo         # IANA timezone — used for display formatting and 03:00 backup cron

# ── Image Delivery (CI/CD) ────────────────────────────────────────────────────
# Which image this server runs, and which pointer tag Watchtower watches.
GHCR_IMAGE=ghcr.io/ktneranga/carpediem-impl
APP_TAG=stable                # `stable` = all restaurants. For a targeted rollout use
                              # `stable-<scope>` (e.g. stable-carpe-diem) and set
                              # RESTAURANT_SCOPE to match. NEVER set this to `latest`.

RESTAURANT_SCOPE=default      # Unique per restaurant (e.g. carpe-diem, beach-shack).
                              # Confines this server's Watchtower to its own containers,
                              # so one restaurant's update cannot touch another's.

# GitHub PAT used ONLY to pull the private image from GHCR.
# Scope: read:packages — nothing else. Never a write-scoped token.
REPO_USER=                    # GitHub username
REPO_PASS=                    # PAT with read:packages only

# ── CI secrets (set in GitHub, NOT in this file) ──────────────────────────────
# DEPLOY_HEALTH_URL   — Tailscale URL of this server's health endpoint,
#                       e.g. http://100.64.12.5:3000/api/health
# TS_OAUTH_CLIENT_ID  — Tailscale OAuth client for the CI runner (ephemeral, tag:ci)
# TS_OAUTH_SECRET     — Tailscale OAuth secret
# Restrict tag:ci in your Tailscale ACLs to port 3000 only — CI has no reason to
# reach Portainer (9000) or Uptime Kuma (3001).
